# Copy this file to .env.local for local development (`npm run dev`), and set the same
# three variables in Netlify: Site configuration -> Environment variables -> Add a variable.
# .env.local is already git-ignored by the Next.js starter — never commit real secrets.

# Supabase project (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for the unlisted moderation queue at /admin/reviews.
# Pick any strong random string — this isn't a username/password pair, just one secret.
ADMIN_REVIEWS_PASSWORD=
